# GenLayer RPC API URL
# Default: https://studio.genlayer.com/api
# Use this default for production, or provide your own GenLayer node URL for local development
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# GenLayer Network Configuration
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# ClaimGuard Intelligent Contract Address
# This is the address of your deployed claim_guard.py contract on GenLayer.
# See docs/DEPLOYMENT.md for how to deploy the contract from
# contracts/claim_guard.py via Studio UI or the gltest CLI.
# Example: NEXT_PUBLIC_CONTRACT_ADDRESS=0x32b9c530822e4d8da5918b9a431b625066b03d6d
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address
